#include <iostream>
#include <vector>
#include <cmath>
#include <iomanip>

using namespace std;

double distance(const vector<double> &p1, const vector<double> &p2)
{
    return sqrt((p1[0] - p2[0]) * (p1[0] - p2[0]) +
                (p1[1] - p2[1]) * (p1[1] - p2[1]));
}
double minpat(const vector<vector<double>> &points)
{
    int n = points.size();
    double minDist = 1e9;

    for (int i = 0; i < n; ++i)
    {
        for (int j = i + 1; j < n; ++j)
        {
            double dist = distance(points[i], points[j]);
            if (dist < minDist)
            {
                minDist = dist;
            }
        }
    }
    return minDist;
}
int main()
{
    vector<vector<double>> points = {{-1, -2}, {0, 0}, {1, 2}};
    double res = minpat(points);
    cout << res << endl;
    return 0;
}